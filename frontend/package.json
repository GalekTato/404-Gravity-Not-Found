{
  "name": "terrasync",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "stack:up": "docker compose -f ../docker-compose.yml up --build -d --wait",
    "stack:down": "docker compose -f ../docker-compose.yml down",
    "stack:logs": "docker compose -f ../docker-compose.yml logs --tail 100 web",
    "datos:geografia": "node ../scripts/importar-geografia.mjs",
    "datos:verificar": "node ../scripts/verificar-geografia.mjs",
    "typecheck": "tsc -b --pretty false",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "maplibre-gl": "^6.18.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "tailwindcss": "^4.3.5",
    "three": "^0.187.0",
    "workbox-window": "7.4.1"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0"
  }
}
