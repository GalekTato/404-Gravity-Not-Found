# Django configuration
DEBUG=False
SECRET_KEY=

# PostgreSQL configuration
DATABASE_NAME=nasa_db
DATABASE_USER=nasa
DATABASE_PASSWORD=
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432

# Redis configuration
REDIS_URL=redis://127.0.0.1:6379/1

# Comma-separated hostnames and browser origins
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Pipeline data root (default inside Docker Compose: /pipeline_data)
PIPELINE_DATA_ROOT=/pipeline_data
