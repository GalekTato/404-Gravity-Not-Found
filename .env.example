# Django configuration
DEBUG=False
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
DRF_ANON_RATE=600/min

# PostgreSQL configuration (PostgreSQL-only backend)
DATABASE_NAME=nasa_db
DATABASE_USER=nasa
DATABASE_PASSWORD=
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432

# Redis configuration
REDIS_URL=redis://127.0.0.1:6379/1

# Pipeline data root (inside Docker Compose: /pipeline_data)
PIPELINE_DATA_ROOT=/pipeline_data

# Optional Docker production compose overrides (use separate ignored .env.deploy)
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080

# Optional Vite build overrides for GitHub Pages / split hosting
# VITE_BASE_PATH=/404-Gravity-Not-Found/
# VITE_API_BASE_URL=https://tu-api-django.onrender.com
